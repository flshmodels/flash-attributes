<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <Item class="Script" referent="RBX0">
    <Properties>
      <string name="Name">FlashAttributes</string>
      <ProtectedString name="Source">if not plugin then return end

local Selection = game:GetService("Selection")
local RunService = game:GetService("RunService")
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local Ui = require(script.Ui)
local Adapter = require(script.Adapter)
local Transaction = require(script.Transaction)
local panel = Ui.new(plugin, "FlashAttributes", "Flash Attributes", "Attributes")
local plan = nil
local status
local preview
local function invalidate()
    plan = nil
    if status then status.Text = "Selection or options changed. Preview again before applying." end
    if preview then preview.Text = "" end
end
local options = Adapter.controls(panel, invalidate)
status = panel.label("Select objects in Explorer, then preview the changes.")
panel.button("Preview selection", function()
    plan = nil
    preview.Text = ""
    if RunService:IsRunning() then status.Text = "Stop the play test first." return end
    local ok, result = pcall(Adapter.plan, Selection:Get(), options())
    if not ok then status.Text = tostring(result) return end
    plan = result
    status.Text = string.format("%d changes. Preview shows up to 100 rows. No objects have been edited.", #plan)
    local lines = {}
    for index, entry in ipairs(plan) do
        if index &gt; 100 then break end
        table.insert(lines, entry.label)
    end
    preview.Text = table.concat(lines, "\n\n")
end)
panel.button("Apply preview", function()
    if RunService:IsRunning() then status.Text = "Stop the play test first." invalidate() return end
    if not plan then status.Text = "Preview the selection first." return end
    local _, message = Transaction.apply(plan, Adapter, {
        begin = function() return ChangeHistoryService:TryBeginRecording("FlashAttributes.Apply", "Flash Attributes") end,
        finish = function(recording, commit)
            ChangeHistoryService:FinishRecording(recording, if commit then Enum.FinishRecordingOperation.Commit else Enum.FinishRecordingOperation.Cancel)
        end,
    })
    plan = nil
    status.Text = message
    preview.Text = ""
end)
preview = panel.label("")
preview.TextSize = 14
local selectionConnection = Selection.SelectionChanged:Connect(invalidate)
plugin.Unloading:Connect(function()
    selectionConnection:Disconnect()
    panel.destroy()
end)
</ProtectedString>
    </Properties>
    <Item class="ModuleScript" referent="RBX1">
      <Properties>
        <string name="Name">Adapter</string>
        <ProtectedString name="Source">local Rules = require(script.Parent.Rules)
local Adapter = {}

local function describe(value)
    if value == nil then return "(absent)" end
    local text = tostring(value):gsub("%c", " ")
    if not utf8.len(text) then return "(invalid UTF-8) [" .. typeof(value) .. "]" end
    local stop = utf8.offset(text, 121)
    if stop then text = string.sub(text, 1, stop - 1) .. "..." end
    return text .. " [" .. typeof(value) .. "]"
end

function Adapter.controls(panel, changed)
    panel.label("Set or remove one attribute on selected objects only. Existing attributes with another type are refused. Delete removes the named attribute, not the object.")
    local name = panel.field("Attribute name", "InteractionId")
    local kind = panel.cycle("Operation / type", { "String", "Number", "Boolean", "Delete" }, changed)
    local value = panel.field("Value (ignored for Delete)", "")
    name:GetPropertyChangedSignal("Text"):Connect(changed)
    value:GetPropertyChangedSignal("Text"):Connect(changed)
    return function() return { name = name.Text, kind = kind(), text = value.Text } end
end

function Adapter.plan(selection, options)
    Rules.parse(options.name, options.kind, options.text)
    local rows, seen = {}, {}
    assert(#selection &lt;= 500, "Select no more than 500 objects.")
    for _, object in ipairs(selection) do
        assert(object.Parent and object:IsDescendantOf(game) and object.Parent ~= game, "Select objects inside a service, not the service itself.")
        if not seen[object] then
            seen[object] = true
            table.insert(rows, { target = object, parent = object.Parent, value = object:GetAttribute(options.name) })
        end
    end
    local plan = Rules.plan(rows, options)
    for _, entry in ipairs(plan) do
        entry.label = entry.before.target:GetFullName() .. "\n" .. entry.attribute .. ": " .. describe(entry.before.value) .. " -&gt; " .. describe(entry.after)
    end
    return plan
end

function Adapter.validate(plan)
    for _, entry in ipairs(plan) do
        local before = entry.before
        if not before.target:IsDescendantOf(game) or before.target.Parent ~= before.parent or before.target:GetAttribute(entry.attribute) ~= before.value then
            return false, "An object or attribute changed after the preview. Preview again."
        end
    end
    return true
end

function Adapter.write(entry)
    entry.before.target:SetAttribute(entry.attribute, entry.after)
end

return Adapter
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX2">
      <Properties>
        <string name="Name">Rules</string>
        <ProtectedString name="Source">local Rules = {}

function Rules.parse(name, kind, text)
    assert(type(name) == "string" and #name &gt; 0 and #name &lt;= 100 and name:match("^[%w_./-]+$") and name:sub(1, 3):lower() ~= "rbx", "Attribute names must be 1-100 ASCII letters, digits, periods, hyphens, slashes or underscores, without an RBX prefix.")
    if kind == "Delete" then return nil end
    assert(type(text) == "string", "Enter an attribute value.")
    if kind == "String" then
        assert(#text &lt;= 1024 and utf8.len(text), "String values must be valid UTF-8 and at most 1024 bytes.")
        return text
    elseif kind == "Number" then
        local value = tonumber(text)
        assert(value and value == value and math.abs(value) &lt;= 1000000000000, "Enter a finite number between -1e12 and 1e12.")
        return value
    elseif kind == "Boolean" then
        assert(text == "true" or text == "false", "Boolean values must be exactly true or false.")
        return text == "true"
    end
    error("Choose String, Number, Boolean or Delete.")
end

function Rules.plan(rows, options)
    assert(#rows &gt; 0 and #rows &lt;= 500, "Select between 1 and 500 objects.")
    local value = Rules.parse(options.name, options.kind, options.text)
    local plan = {}
    for _, row in ipairs(rows) do
        if options.kind ~= "Delete" and row.value ~= nil then
            assert(type(row.value) == type(value), "An existing attribute has a different type. Delete it first if the change is intentional.")
        end
        if row.value ~= value then table.insert(plan, { before = row, after = value, attribute = options.name }) end
    end
    return plan
end

return Rules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX3">
      <Properties>
        <string name="Name">Transaction</string>
        <ProtectedString name="Source">local Transaction = {}

function Transaction.apply(plan, adapter, history)
    if #plan == 0 then return false, "Nothing to change." end
    local checked, valid, reason = pcall(adapter.validate, plan)
    if not checked then return false, "The preview could not be checked. Preview again: " .. tostring(valid) end
    if not valid then return false, reason end
    local started, recording = pcall(history.begin)
    if not started or not recording then
        return false, "Studio could not start an undo recording. Try again in edit mode."
    end
    local ok, err = pcall(function()
        for _, entry in ipairs(plan) do adapter.write(entry) end
    end)
    if ok then
        ok, err = pcall(history.finish, recording, true)
    end
    if not ok then
        local cancelled = pcall(history.finish, recording, false)
        if not cancelled then
            return false, "The edit failed and Studio could not cancel its recording. Check the place and undo history: " .. tostring(err)
        end
        return false, "The batch was cancelled: " .. tostring(err)
    end
    return true, string.format("Applied %d changes. Use Studio Undo to revert the batch.", #plan)
end

return Transaction
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX4">
      <Properties>
        <string name="Name">Ui</string>
        <ProtectedString name="Source">local Ui = {}

function Ui.new(plugin, id, title, action)
    local studio = settings().Studio
    local colors = {}
    local connections = {}
    local toolbar = plugin:CreateToolbar(title)
    local toggle = toolbar:CreateButton(id, title, "", action)
    local widget = plugin:CreateDockWidgetPluginGuiAsync(id .. "_v1", DockWidgetPluginGuiInfo.new(
        Enum.InitialDockState.Right, false, false, 380, 600, 280, 260
    ))
    widget.Title = title
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.fromScale(1, 1)
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 6
    scroll.CanvasSize = UDim2.new()
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.ScrollingDirection = Enum.ScrollingDirection.Y
    scroll.Parent = widget
    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 14)
    padding.PaddingBottom = UDim.new(0, 14)
    padding.PaddingLeft = UDim.new(0, 14)
    padding.PaddingRight = UDim.new(0, 20)
    padding.Parent = scroll
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 9)
    layout.Parent = scroll
    local order = 0
    local function theme(object, property, color)
        table.insert(colors, { object, property, color })
        object[property] = studio.Theme:GetColor(Enum.StudioStyleGuideColor[color])
    end
    theme(scroll, "BackgroundColor3", "MainBackground")
    theme(scroll, "ScrollBarImageColor3", "MainText")
    local function add(class, text)
        order = order + 1
        local object = Instance.new(class)
        object.LayoutOrder = order
        object.Size = UDim2.new(1, 0, 0, 32)
        object.BorderSizePixel = 0
        object.Font = Enum.Font.SourceSans
        object.TextSize = 16
        object.Text = text
        object.TextWrapped = true
        object.Parent = scroll
        theme(object, "TextColor3", "MainText")
        return object
    end
    local panel = { widget = widget }
    function panel.label(text)
        local object = add("TextLabel", text)
        object.Size = UDim2.new(1, 0, 0, 0)
        object.AutomaticSize = Enum.AutomaticSize.Y
        object.BackgroundTransparency = 1
        object.TextXAlignment = Enum.TextXAlignment.Left
        return object
    end
    function panel.field(caption, initial)
        panel.label(caption)
        local object = add("TextBox", initial)
        object.ClearTextOnFocus = false
        object.TextWrapped = false
        theme(object, "BackgroundColor3", "InputFieldBackground")
        return object
    end
    function panel.button(text, callback)
        local object = add("TextButton", text)
        theme(object, "BackgroundColor3", "Button")
        table.insert(connections, object.Activated:Connect(callback))
        return object
    end
    function panel.cycle(caption, choices, changed)
        local index = 1
        local button
        button = panel.button(caption .. ": " .. choices[index], function()
            index = index % #choices + 1
            button.Text = caption .. ": " .. choices[index]
            changed()
        end)
        return function() return choices[index] end
    end
    panel.label(title)
    table.insert(connections, toggle.Click:Connect(function() widget.Enabled = not widget.Enabled end))
    table.insert(connections, widget:GetPropertyChangedSignal("Enabled"):Connect(function()
        toggle:SetActive(widget.Enabled)
    end))
    table.insert(connections, studio.ThemeChanged:Connect(function()
        for _, item in ipairs(colors) do
            item[1][item[2]] = studio.Theme:GetColor(Enum.StudioStyleGuideColor[item[3]])
        end
    end))
    toggle:SetActive(widget.Enabled)
    function panel.destroy()
        for _, connection in ipairs(connections) do connection:Disconnect() end
        widget:Destroy()
        toolbar:Destroy()
    end
    return panel
end

return Ui
</ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>